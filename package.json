{
  "name": "restaurant-pos",
  "version": "1.0.0",
  "description": "Sistema de Pedidos y Facturación para Restaurante",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "electron": "electron .",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron ./electron/main.js",
    "dev:desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "electron:build": "vite build && electron-builder",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.farid.pedidos",
    "productName": "Sistema de Pedidos",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "database/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Farid324",
        "repo": "PedidosProyecto"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/logo256.png"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.10",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "electron-is-dev": "^3.0.1",
    "electron-pos-printer": "^1.3.8",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "lucide-react": "^0.544.0",
    "pdfmake": "^0.2.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "zustand": "^5.0.8"
  }
}
